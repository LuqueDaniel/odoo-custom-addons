<odoo>
    <record id="view_partner_property_form" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <!-- Adds customer_rank and supplier_rank fields to determine if the partner is a customer or a supplier -->
            <xpath expr="//form" position="inside">
                <field name="customer_rank" invisible="1" />
                <field name="supplier_rank" invisible="1" />
            </xpath>
            <field name="supplier_payment_mode_id" position="attributes">
                <attribute
                    name="attrs"
                >{'required': [('supplier_rank', '>', 0)]}</attribute>
            </field>
            <field name="property_supplier_payment_term_id" position="attributes">
                <attribute
                    name="attrs"
                >{'required': [('supplier_rank', '>', 0)]}</attribute>
            </field>
            <field name="customer_payment_mode_id" position="attributes">
                <attribute
                    name="attrs"
                >{'required': [('customer_rank', '>', 0)]}</attribute>
            </field>
            <field name="property_payment_term_id" position="attributes">
                <attribute
                    name="attrs"
                >{'required': [('customer_rank', '>', 0)]}</attribute>
            </field>
        </field>
    </record>
</odoo>
