<odoo>
    <!-- Bank statement overrides updated for Odoo 13 below (use button_reopen and a single cancel_reconciliation entry). -->
    <record id="payment_cancel_form_inherit" model="ir.ui.view">
        <field name="name">payment.cancel.form.inherit</field>
        <field name="model">account.payment</field>
        <field name="priority">110</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='cancel']" position="attributes">
                <attribute name="groups">account_cancel_permission.group_cancel_journal_entries</attribute>
            </xpath>
        </field>
    </record>
    <!-- Odoo 13: account.invoice are now account.move -->
    <record id="move_form_cancel_inherit" model="ir.ui.view">
        <field name="name">account.move.form.cancel.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="priority">120</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_cancel']" position="attributes">
                <attribute name="groups">account.group_account_invoice,account_cancel_permission.group_cancel_journal_entries</attribute>
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="groups">account.group_account_invoice,account_cancel_permission.group_cancel_journal_entries</attribute>
            </xpath>
        </field>
    </record>
    <record id="bank_statement_reopen_form_inherit" model="ir.ui.view">
        <field name="name">bank.statement.reopen.form.inherit</field>
        <field name="model">account.bank.statement</field>
        <field name="inherit_id" ref="account.view_bank_statement_form" />
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_reopen']" position="attributes">
                <attribute name="groups">account_cancel_permission.group_cancel_journal_entries</attribute>
            </xpath>
        </field>
    </record>
    <record id="bank_statement_cancel_form_inherit" model="ir.ui.view">
        <field name="name">bank.statement.cancel.form.inherit</field>
        <field name="model">account.bank.statement</field>
        <field name="inherit_id" ref="account.view_bank_statement_form" />
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_cancel_reconciliation']" position="attributes">
                <attribute name="groups">account_cancel_permission.group_cancel_journal_entries</attribute>
            </xpath>
        </field>
    </record>
</odoo>
